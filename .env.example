# ==============================================================================
# CodeCoBUG Environment Variables Template
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Persistence & Authentication (Required in Phase 5)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# AI Credential Encryption Key (Required in Phase 6 - 32-byte hex or base64)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# Optional Server-Side Default AI Keys (Optional fallback when learner has not supplied BYOK)
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...
